\name{morganafa-package}
\alias{morganafa-package}
\alias{morganafa}
\title{MORGANA Factor Analysis with Correlated Residuals}
\description{
\code{morganafa} implements core routines from the MORGANA methodology for exploratory and confirmatory factor analysis with correlated residuals.
}
\details{
Main capabilities include:
\itemize{
  \item automatic doublet detection via EREC,
  \item unrestricted estimation with correlated residuals,
  \item LOSEFER empirical correction for fit indices,
  \item high-level workflows through \code{solutionMEFA()} and \code{solutionMCFA()}.
}
}
